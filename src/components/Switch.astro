---
import { IconInfoCircleFilled } from "@tabler/icons-react";

interface Props {
	disabled?: boolean;
	required?: boolean;
	info?: boolean;
	optional?: string;
	HelpText?: string;
	HelpTextDanger?: boolean;
}

const { disabled, required, optional, HelpText, info, HelpTextDanger } =
	Astro.props;
---

<label
	class:list=`flex flex-row gap-4 items-center ${
		disabled ? "cursor-not-allowed" : "cursor-pointer"
	}`>
	<input type="checkbox" value="" class="peer sr-only" disabled={disabled} />
	<div
		class="relative h-6 w-11 rounded-full bg-background-400 peer-checked:bg-primary-600 after:absolute after:start-[2px] after:top-[2px] after:size-5 after:rounded-full peer-checked:after:bg-primary-100 after:bg-background-100 after:transition-all after:duration-200 after:ease-in-out after:content-[''] peer-checked:after:translate-x-full peer-active:after:scale-110 rtl:peer-checked:after:-translate-x-full dark:bg-background-600 peer-checked:dark:bg-primary-400 dark:peer-checked:after:bg-primary-950">
	</div>
	<div>
		<span class="flex flex-row items-center gap-1">
			<span class="texto-label text-text-950 select-none">
				<slot />
			</span>
			{
				optional && (
					<span class="texto-label text-text-700 select-none">
						{"("}{optional}{")"}
					</span>
				)
			}
			{
				required && (
					<span class="texto-label text-danger-600 select-none">
						*
					</span>
				)
			}
			{info && <IconInfoCircleFilled />}
		</span>
		{
			HelpText && (
				<span
					class={`texto-label font-bold select-none ${HelpTextDanger ? "text-danger-700" : "text-text-700"}`}>
					{HelpText}
				</span>
			)
		}
	</div>
</label>
