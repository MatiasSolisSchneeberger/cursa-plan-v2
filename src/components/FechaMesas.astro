---
import { Icon } from "astro-icon/components";
import { examenes } from "@data/mesaDeExamenes.json";
import TarjetaInfo from "@components/TarjetaInfo.astro";
import Button from "@components/Button.astro";
import { IconCalendar } from "@tabler/icons-react";
import MenuItem from "./MenuItem.astro";

interface Props {
	materia: string;
	dispositivo: string;
	carrera?: string;
}

const { materia, dispositivo, carrera } = Astro.props;

// Constants
const GOOGLE_CALENDAR_BASE_URL =
	"https://www.google.com/calendar/render?action=TEMPLATE";
const CURRENT_DATE = new Date();
CURRENT_DATE.setHours(0, 0, 0, 0); // Reset time to start of day for accurate comparison

const materiaEncontrada = examenes.find((e) => e.materia === materia) || {
	fechas: [],
};

// Función para obtener partes de la fecha
function descomponerFecha(fechaStr: string | Date) {
	const fecha = new Date(fechaStr);
	return {
		dia: fecha.getDate(),
		mes: fecha.getMonth() + 1, // meses empiezan en 0
		anio: fecha.getFullYear(),
	};
}

// Función para generar link de Google Calendar
function linkGoogleCalendar(fechaStr: string, titulo: string) {
	const { anio, mes, dia } = descomponerFecha(fechaStr);

	// Formato YYYYMMDD para Google Calendar
	const fechaFormato = `${anio}${String(mes).padStart(2, "0")}${String(dia).padStart(2, "0")}`;

	return `${GOOGLE_CALENDAR_BASE_URL}&text=${encodeURIComponent(titulo)}&dates=${fechaFormato}/${fechaFormato}`;
}

const proximaFecha = materiaEncontrada.fechas.find((f) => {
	const fecha = new Date(f);
	fecha.setHours(0, 0, 0, 0); // reset horas para evitar problemas
	return fecha >= CURRENT_DATE;
});

function formatoFecha(fecha: string) {
	return `${descomponerFecha(fecha).dia.toString().padStart(2, "0")}/${descomponerFecha(fecha).mes.toString().padStart(2, "0")}/${descomponerFecha(fecha).anio.toString().slice(-2)}`;
}
---

<TarjetaInfo style="tertiary" titulo="Proxima Mesa">
	<section
		class="relative flex w-full flex-col items-center justify-center gap-2 p-2">
		<div class="texto-label py-2">
			{
				proximaFecha ? (
					<p>{formatoFecha(proximaFecha)}</p>
				) : (
					<h4>No hay Fechas</h4>
				)
			}
		</div>

		<footer
			class="relative flex shrink-0 flex-wrap items-start justify-start gap-2.5 self-stretch">
			<Button
				className="w-full flex-1"
				style="tertiary"
				onclick={`document.getElementById('dialog-${materia}-${dispositivo}').showModal()`}>
				Ver Mas
			</Button>

			<Button style="primary" className="w-full flex-1" target="_blank">
				Agendar
				<IconCalendar slot="iconRight" />
			</Button>
		</footer>
	</section>
</TarjetaInfo>

<!-- Exam dates dialog -->
{
	proximaFecha && (
		<dialog
			id={`dialog-${materia}-${dispositivo}`}
			class="fixed w-[90vw] max-w-2xl self-center justify-self-center rounded-2xl bg-background-100 backdrop-blur-sm dark:bg-background-900">
			<div class="item relative flex h-[90vh] w-full flex-col items-center justify-center gap-2.5 p-6">
				{/* Header */}
				<header class="relative flex flex-col items-center justify-center gap-2.5">
					<div class="text-primary-400 dark:text-primary-600">
						<IconCalendar />
					</div>
					<h2 class="texto-headline text-text-800 dark:text-text-200">
						{materia.replace(`(${carrera})`, "")}
					</h2>
				</header>

				{/* Exam dates list */}
				<div class="h-full w-full overflow-y-auto overscroll-contain space-y-2">
					{materiaEncontrada.fechas.map((f) => {
						const fecha = new Date(f);
						return (
							<MenuItem iconLeft={{icon: "calendar", color: "info"}}
								text={formatoFecha(f)}
								className="justify-between"
								textHelp={
									fecha <= CURRENT_DATE && "Fecha Pasada"
								}
								button={{
									text: "Agendar",
									style: "secondary",
									disabled: fecha <= CURRENT_DATE,
									href:
										fecha > CURRENT_DATE &&
										linkGoogleCalendar(f, materia),
									iconLeft: {

									}
								}}
							/>
						);
					})}
				</div>

				{/* Footer */}
				<footer class="pt-4 text-center">
					<Button style="primary"
						onclick={`document.getElementById('dialog-${materia}-${dispositivo}').close()`}>
						Cerrar
					</Button>
				</footer>
			</div>
		</dialog>
	)
}

<style>
	dialog[open] {
		animation: fadeIn 200ms ease-out forwards;
	}

	dialog[open] > div {
		animation: scaleIn 200ms ease-out forwards;
	}

	dialog::backdrop {
		background: rgba(0, 0, 0, 0.3);
		backdrop-filter: blur(4px);
		animation: fadeIn 200ms ease-out forwards;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes scaleIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
