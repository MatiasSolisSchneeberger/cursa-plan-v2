---
import MenuItem from "./MenuItem.astro";

interface Props {
    CursarRendir: "Cursar" | "Rendir"
	requisitos: Array<Condicion> | null;
}

interface Condicion {
	mat: string;
	cond: "R" | "A" | null; // "R" = Regular, "A" = Aprobada
}

const {CursarRendir, requisitos } = Astro.props;

function icon(cond: "R" | "A" | null): string {
	switch(cond){
		case "A": return "circle-letter-a";
		case "R": return "circle-letter-r";
		default: return "point";
	}
}
---

<div
	class="lg:flex-1 flex-initial rounded-2xl flex flex-col gap-0 items-start justify-start flex-grow border-background-300 border-1 overflow-hidden">
	<header
		class="bg-secondary-200 border-b border-background-300 py-2 px-6 flex flex-row w-full gap-2.5 items-center justify-center self-stretch shrink-0">
		<p
			class="text-secondary-800 text-center texto-title relative flex-1 flex items-center justify-center">
			Para {CursarRendir}:
		</p>
	</header>
	<div
		class="flex flex-col items-start justify-start self-stretch flex-grow">
		{/* <!-- Materia --> */}
		{
			requisitos && requisitos.length > 0 ? (
				requisitos.map(({mat, cond}) =>(
					<MenuItem iconLeft={{
						icon: icon(cond),
						size: 22,
						color: "tertiary"
					}}
						text={mat}
					/>
				))
				
			) : (
				<div class="flex flex-row p-2 items-center justify-center flex-grow w-full relative">
					<p class="text-secondary-800 texto-title relative flex items-center text-center justify-center">
						No hay correlativas
					</p>
				</div>
			)
		}
	</div>
</div>
