---
import MenuItem from "./MenuItem.astro";
import TarjetaInfo from "./TarjetaInfo.astro";

interface Props {
	CursarRendir: "Cursar" | "Rendir";
	requisitos: Array<Condicion> | null;
}

interface Condicion {
	mat: string;
	cond: "R" | "A" | null; // "R" = Regular, "A" = Aprobada
}

const { CursarRendir, requisitos } = Astro.props;

function icon(cond: "R" | "A" | null): string {
	switch (cond) {
		case "A":
			return "letter-a";
		case "R":
			return "letter-r";
		default:
			return "point";
	}
}
---

<TarjetaInfo style="secondary" titulo=`Para ${CursarRendir}`>
	{
		requisitos && requisitos.length > 0 ? (
			requisitos.map(({ mat, cond }) => (
				<MenuItem
					iconLeft={{
						icon: icon(cond),
						size: 22,
						color: "tertiary",
					}}
					text={mat}
				/>
			))
		) : (
			<MenuItem text="No hay correlativas" />
		)
	}
</TarjetaInfo>
