---
import { IconSchool } from "@tabler/icons-react";
import { Icon } from "astro-icon/components";
const { theme } = Astro.props;
---

<a
	href="/"
	class="bg-primary-400 text-primary-950 dark:bg-primary-600 dark:text-primary-50 rounded-full p-2.5 flex flex-row gap-2.5 items-center justify-center self-stretch shrink-0 relative overflow-hidden w-min h-min"
	id="logo">
	<IconSchool size="22" />
	<p
		class="logo-text relative flex items-center justify-center text-center font-Poppins text-sm leading-4 font-medium tracking-wide">
		CursaPlan
	</p>
</a>
