---
interface Props {
	titulo: string;
	style: string;
}

const { titulo, style = "primary" } = Astro.props;
---

<div
	class="flex w-full sm:flex-1 flex-initial flex-grow flex-col items-start justify-start gap-0 overflow-hidden rounded-2xl border-1 border-background-300 dark:border-background-700">
	<header
		class:list={[
			"flex w-full shrink-0 flex-row items-center justify-center gap-2.5 self-stretch border-b border-background-300 dark:border-background-700 px-6 py-2",
			{
				"bg-primary-200 text-primary-800 dark:bg-primary-200 dark:text-primary-800":
					style === "primary",
				"bg-secondary-200 text-secondary-800 dark:bg-secondary-200 dark:text-secondary-800":
					style === "secondary",
				"bg-tertiary-200 text-tertiary-800 dark:bg-tertiary-200 dark:text-tertiary-800":
					style === "tertiary",
				"bg-danger-200 text-danger-800 dark:bg-danger-200 dark:text-danger-800":
					style === "danger",
				"bg-warning-200 text-warning-800 dark:bg-warning-200 dark:text-warning-800":
					style === "warning",
				"bg-success-200 text-success-800 dark:bg-success-200 dark:text-success-800":
					style === "success",
				"bg-info-200 text-info-800 dark:bg-info-200 dark:text-info-800":
					style === "info",
			},
		]}>
		<p
			class="texto-title relative flex flex-1 items-center justify-center text-center">
			{titulo}
		</p>
	</header>
	<div class="flex flex-grow flex-col items-start w-full justify-start">
		<slot />
	</div>
</div>
