---
import Divider from "@components/Divider.astro";

interface Props {
	tab: Array<{
		iconLeft?: string;
		label: string;
		chip?: {
			style: string;
			text: string;
			selection?: boolean;
		};
	}>;
    
}

const { tab , ...props} = Astro.props;
---

<div
    
	class="flex w-min flex-row rounded-xl outline-1 outline-background-300 overflow-hidden"
    {...props}
    >
	{
		tab.map(({ label }, index) => (
			<div
				class={`flex items-center ${index !== tab.length - 1 ? "border-background-300 border-r" : ""}`}>
				<a href={`#${label}`} class="texto-label px-5 py-3 text-text-900 transition-colors hover:bg-background-100 h-full">
					{label}
				</a>
			</div>
		))
	}
</div>
