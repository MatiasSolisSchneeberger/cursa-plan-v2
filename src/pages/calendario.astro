---
import Layout from "@layouts/Layout.astro";
import { calendario } from "@data/calendario.json";
import TarjetaLayout from "@components/TarjetaLayout.astro";
import TarjetaInfo from "@components/TarjetaInfo.astro";
import Menu from "@components/Menu.astro";
import MenuItem from "@components/MenuItem.astro";
import { map, undefined } from "astro:schema";
import Divider from "@components/Divider.astro";

const months = [
	{ name: "Enero", days: 31, startDay: 3 },
	{ name: "Febrero", days: 28, startDay: 6 },
	{ name: "Marzo", days: 31, startDay: 6 },
	{ name: "Abril", days: 30, startDay: 2 },
	{ name: "Mayo", days: 31, startDay: 4 },
	{ name: "Junio", days: 30, startDay: 0 },
	{ name: "Julio", days: 31, startDay: 2 },
	{ name: "Agosto", days: 31, startDay: 5 },
	{ name: "Septiembre", days: 30, startDay: 1 },
	{ name: "Octubre", days: 31, startDay: 3 },
	{ name: "Noviembre", days: 30, startDay: 6 },
	{ name: "Diciembre", days: 31, startDay: 1 },
];

const weekDays = ["D", "L", "M", "M", "J", "V", "S"];
---

<Layout title="Calendario 2025">
	{
		calendario.map(({ mes, feriados, periodos }) => (
			<TarjetaLayout titulo={mes}>
				{feriados && (
					<TarjetaInfo style="primary" titulo="Feriados">
						{feriados.map(({ tipo, fechas }, index) => (
							<div class="py-2 w-full">
								<span class="texto-label px-4 py-1 text-text-800 dark:text-text-200">
									{tipo}
								</span>
								{fechas.map(
									({
										dia,
										aclaracion,
										descripcion,
										dia_semana,
									}) => (
										<MenuItem
											text={`${dia.toString().padStart(2, "0")} - ${descripcion}`}
											textHelp={aclaracion}
											chip={{
												text: dia_semana,
												style: "info",
											}}
										/>
									),
								)}
								{feriados.length !== index + 1 && <Divider />}
							</div>
						))}
					</TarjetaInfo>
				)}
				{periodos && (
					<TarjetaInfo style="secondary" titulo="Periodos">
						<div class="py-2">
							{periodos.map(
								({ nombre, inicio, final, aclaracion }) => (
									<MenuItem
										text={`${nombre} - Del ${inicio} al ${final}`}
										textHelp={aclaracion}
									/>
								),
							)}
						</div>
					</TarjetaInfo>
				)}
			</TarjetaLayout>
		))
	}
</Layout>
