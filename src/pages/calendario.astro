---
import Layout from "@layouts/Layout.astro";
import { calendario } from "@data/calendario.json";
import TarjetaLayout from "@components/TarjetaLayout.astro";
import TarjetaInfo from "@components/TarjetaInfo.astro";
import MenuItem from "@components/MenuItem.astro";
import Divider from "@components/Divider.astro";
---

<Layout title="Calendario 2025">
	<section
		class="relative grid w-full grid-cols-1 flex-col items-center justify-center gap-4 overflow-hidden pt-12 md:grid-cols-2 2xl:grid-cols-3">
		{
			calendario.map(({ mes, feriados, periodos }) => (
				<TarjetaLayout titulo={mes}>
					{feriados && (
						<TarjetaInfo style="primary" titulo="Feriados">
							{feriados.map(({ tipo, fechas }, index) => {
								var estilo: string;
								switch (tipo) {
									case "Feriado Inamovible":
										estilo = "danger";
										break;
									case "Día No Laborable":
										estilo = "warning";
										break;
									case "Feriado Trasladable":
										estilo = "primary";
										break;

									default:
										estilo = "info";
										break;
								}
								return (
									<div class="w-full py-2">
										<span class="texto-label px-4 py-1 text-text-800 dark:text-text-200">
											{tipo}
										</span>
										{fechas.map(
											({
												dia,
												aclaracion,
												descripcion,
												dia_semana,
											}) => (
												<MenuItem
													text={`${dia.toString().padStart(2, "0")} - ${descripcion}`}
													textHelp={aclaracion}
													chip={{
														text: dia_semana,
														style: estilo,
													}}
												/>
											),
										)}
										{feriados.length !== index + 1 && (
											<Divider />
										)}
									</div>
								);
							})}
						</TarjetaInfo>
					)}
					{periodos && (
						<TarjetaInfo style="secondary" titulo="Periodos">
							<div class="py-2">
								{periodos.map(
									({ nombre, inicio, final, aclaracion }) => (
										<MenuItem
											text={`${nombre} - Del ${inicio} al ${final}`}
											textHelp={aclaracion}
										/>
									),
								)}
							</div>
						</TarjetaInfo>
					)}
				</TarjetaLayout>
			))
		}
	</section>
</Layout>
