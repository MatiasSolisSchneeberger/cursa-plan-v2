---
import type { GetStaticPaths } from "astro";

import { carreras } from "@data/carreras.json";

import Layout from "@layouts/Layout.astro";
import AñoCarrera from "@sections/AñoCarrera.astro";
import HeaderCarrera from "@sections/HeaderCarrera.astro";
import BuscadorMaterias from "@components/BuscadorMaterias.jsx";
import Tabs from "@components/Tabs.astro";

// Define interfaces for type safety

export const getStaticPaths: GetStaticPaths = () => {
    return carreras.map(({ slag }) => ({
        params: { carrera: slag },
    }));
};

const { carrera: carreraSlug } = Astro.params;

// Buscar los datos específicos de la carrera usando el slag
const carreraData = carreras.find((c) => c.slag === carreraSlug);

if (!carreraData) return Astro.redirect("/404");

function formatoAño(numero: number): string {
	switch (numero) {
		case 1:
			return "1ro";
		case 2:
			return "2do";
		case 3:
			return "3er";
		default:
			return `${numero}to`;
	}
}

const {carrera, cursada, emoji, slag} = carreraData
---

<Layout
	title={`${carrera} | Plan de estudio`}
	theme={slag}>
	<HeaderCarrera carrera={carrera} emoji={emoji} />

	<BuscadorMaterias
		client:load
		placeholder="Buscar materia..."
		targetClass="materia-card"
	/>
	{
		cursada && (
			<Tabs
				tab={cursada.map((item) => ({
					label: formatoAño(item.año),
					href: `#Año-${item.año}`,
				}))}
			/>
		)
	}

	<section id="materias-container" class="space-y-8">
		{
			cursada.map(({ año, materias, orientaciones }) => (
				<AñoCarrera
					carrera={carreraSlug}
					año={año}
					materias={materias}
					carrera={carrera}
					orientaciones={orientaciones}
				/>
			))
		}
	</section>
</Layout>

<script>
	function handleSearch(searchTerm: string) {
		const searchTermLower = searchTerm.toLowerCase();
		const materiasContainer = document.getElementById("materias-container");
		if (!materiasContainer) return;

		const tarjetas =
			materiasContainer.getElementsByClassName("materia-card");

		Array.from(tarjetas).forEach((tarjeta) => {
			const nombreMateria =
				tarjeta.querySelector("h3")?.textContent?.toLowerCase() || "";
			const codigoMateria =
				tarjeta.querySelector(".codigo")?.textContent?.toLowerCase() ||
				"";

			if (
				nombreMateria.includes(searchTermLower) ||
				codigoMateria.includes(searchTermLower)
			) {
				(tarjeta as HTMLElement).style.display = "";
			} else {
				(tarjeta as HTMLElement).style.display = "none";
			}
		});
	}

	// Exponer la función al componente React
	(window as any).handleSearch = handleSearch;
</script>
