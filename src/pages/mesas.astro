---
import Layout from "@layouts/Layout.astro";
import { examenes } from "@data/mesaDeExamenes.json";
import BuscadorMaterias from "@components/BuscadorMaterias";
import FechaMesas from "@components/FechaMesas.astro";
import TarjetaLayout from "@components/TarjetaLayout.astro";
---

<Layout title="Mesas de Examen" pagina="Mesas de Exámenes">
	<header>
		<h1 class="texto-display">Mesa de exámenes</h1>
		<span>
			En el caso de no encontrar una materia revisar la resolución
			oficial.
		</span>
	</header>

	<section class="space-y-4">
		<BuscadorMaterias
			client:load
			placeholder="Buscar materia..."
			targetClass="mesa-row"
		/>

		<article class="mt-4 w-full overflow-x-auto">
			<div
				class="grid grid-cols-1 flex-col gap-4 md:grid-cols-2 lg:grid-cols-3">
				{
					examenes.map(({ materia }) => {
						return (
							<TarjetaLayout
								titulo={materia}>
								<footer class="flex h-full w-full flex-col gap-2.5">
									<FechaMesas
										materia={materia}
										dispositivo="Desktop"
									/>
								</footer>
							</TarjetaLayout>
						);
					})
				}
			</div>
		</article>
	</section>
</Layout>
