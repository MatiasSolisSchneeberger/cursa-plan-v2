---
import BotonTema from "@components/BotonTema.astro";
import Button from "@components/Button.astro";
import ButtonIcon from "@components/ButtonIcon.astro";
import LogoPagina from "@components/LogoPagina.astro";
import { IconMenu2 } from "@tabler/icons-react";
const { pagina } = Astro.props;
const paginas = [
	{ nombre: "Inicio", href: "/" },
	{ nombre: "Mesas de Exámenes", href: "/mesas" },
	{ nombre: "Calendarios", href: "/calendario" },
];
---

<header
	class="flex w-full flex-wrap transition- items-center justify-between rounded-3xl bg-background-100 dark:bg-background-900 p-2.5 shadow-xl outline-1 outline-background-400">
	<LogoPagina />

	<!-- Botón hamburguesa -->
	<ButtonIcon id="boton-menu" style="primary" size="md" className="md:hidden">
		<IconMenu2 />
	</ButtonIcon>

	<!-- Menú que se animará -->
	<nav
		id="menu"
		class="hidden w-full overflow-hidden transition-all duration-300 ease-in-out md:block md:!max-h-none md:w-auto md:overflow-visible">
		<ul
			class="mt-4 flex flex-col gap-3 rounded-lg md:mt-0 md:flex-row md:border-0 md:bg-transparent rtl:space-x-reverse">
			<li>
				<md-divider inset></md-divider>
			</li>
			{
				paginas.map(({ href, nombre }) => {
					if (pagina !== nombre) {
						return (
							<li>
								<Button
									href={href}
									style="primary"
									>
									{nombre}
								</Button>
							</li>
						);
					}
				})
			}
			<li class="justify-items-center">
				<BotonTema />
			</li>
		</ul>
	</nav>
</header>

<script is:inline>
	const boton = document.getElementById("boton-menu");
	const menu = document.getElementById("menu");

	let abierto = false;

	boton?.addEventListener("click", () => {
		if (!menu) return;

		if (!abierto) {
			// Mostrar: quitar hidden, iniciar animación
			menu.classList.remove("hidden");
			menu.classList.add("overflow-hidden");
			menu.style.maxHeight = "0px";

			requestAnimationFrame(() => {
				menu.style.maxHeight = menu.scrollHeight + "px";
			});

			// Remover overflow-hidden al terminar animación
			menu.addEventListener(
				"transitionend",
				() => {
					menu.classList.remove("overflow-hidden");
					menu.style.maxHeight = "none"; // limpia inline-style
				},
				{ once: true },
			);
		} else {
			// Ocultar: animar colapso
			menu.classList.add("overflow-hidden");
			menu.style.maxHeight = menu.scrollHeight + "px"; // necesario para forzar animación desde altura real

			// Luego forzar colapso a 0
			requestAnimationFrame(() => {
				menu.style.maxHeight = "0px";
			});

			// Ocultar completamente al terminar
			menu.addEventListener(
				"transitionend",
				() => {
					menu.classList.add("hidden");
					menu.classList.remove("overflow-hidden");
					menu.style.maxHeight = null;
				},
				{ once: true },
			);
		}

		abierto = !abierto;
	});
</script>
