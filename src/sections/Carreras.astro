---
import { supabase } from "@lib/supabase";

import { carreras } from "@data/carreras.json";
import TarjetaCarrera from "@components/TarjetaCarrera.astro";

const { data, error } = await supabase
	.from("carreras")
	.select("nombre,slug,emojie")
    .order("nombre");
---

<section
	class="relative flex shrink-0 flex-col flex-wrap content-start items-center justify-center gap-6 self-stretch">
	<h2 class="texto-headline text-center text-text-950 dark:text-text-50">
		Carreras
	</h2>
	<ul
		class="relative grid w-full shrink-0 grid-cols-1 flex-wrap content-start items-start justify-start gap-6 self-stretch md:grid-cols-2 lg:grid-cols-3">
		{
			data
				/*?.filter((item) => item.slug != "profesorado-en-ciencias-quimicas-y-del-ambiente")*/
				?.map(({ nombre, slug, emojie }) => {
					return (
						<TarjetaCarrera
							slug={slug}
							carrera={nombre}
							emoji={emojie}
						/>
					);
				})
		}
	</ul>
</section>
