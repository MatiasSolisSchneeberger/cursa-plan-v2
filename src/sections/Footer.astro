---
import LogoPagina from "@components/LogoPagina.astro";
import MenuItem from "@components/MenuItem.astro";
import MiLogo from "@components/MiLogo.astro";
import { carreras } from "@data/carreras.json";

const enlacesCarreras = carreras.map(({ carrera, slag, emoji }) => {
	// Reemplazos para mostrar versión corta
	carrera = carrera
		.replace(/\bIngeniería\b/, "Ing.")
		.replace(/\bLicenciatura\b/, "Lic.")
		.replace(/\bProfesorado\b/, "Prof.");

	return {
		carrera,
		href: `/carreras/${slag}`,
		slag,
		emoji,
	};
});

const contactos = [
	{
		label: "Github",
		link: "https://github.com/MatiasSolisSchneeberger",
		icono: "brand-github",
	},
	{
		label: "Matias.Solis.Sch@gmail.com",
		icono: "mail",
	},
	{
		label: "Linkedin",
		link: "https://www.linkedin.com/in/matias-solis-schneeberger-40a6842ab/",
		icono: "brand-linkedin",
	},
	{
		label: "Repositorio",
		link: "https://github.com/MatiasSolisSchneeberger/the-swifties-eras-tour",
		icono: "brand-github-filled",
	},
];
---

<section
	class="text-on-surface-variant flex w-full flex-col items-start gap-6 rounded-3xl bg-background-100 p-10 shadow-xl outline-1 outline-background-300 lg:flex-row dark:bg-background-900 dark:outline-background-700">
	<article class="texto-body flex w-full flex-col gap-2 text-left">
		<LogoPagina />

		<p>
			Este sitio no es una página oficial de FaCENA. Está diseñado para
			brindar información de manera más accesible y organizada.
		</p>
		<p>
			Si encuentras algún error, como fechas incorrectas, cambios en los
			materiales o cualquier otra información desactualizada, no dudes en
			contactarme para corregirlo. ¡Tu ayuda es muy valiosa para mantener
			esta página actualizada y útil para todos!
		</p>

		<div class="h-10 justify-start">
			<MiLogo />
		</div>
	</article>

	<aside
		class="grid w-full grid-cols-1 items-start gap-4 overflow-hidden sm:gap-4 md:grid-cols-2">
		<div class="flex flex-col gap-1">
			<h4 class="texto-title">Contacto:</h4>
			{
				contactos.map(({ label, link, icono }) => (
					<MenuItem
						text={label}
						iconLeft={{ icon: icono }}
						href={link}
					/>
				))
			}
		</div>
		<div class="flex flex-col gap-1">
			<h2 class="texto-title">Carreras:</h2>
			<div
				class="relative shrink-0 flex-col items-start justify-start gap-2.5 sm:flex">
				{
					enlacesCarreras.map(
						({ href, emoji, carrera , slag}) => (
							<MenuItem
								className={`theme-${slag}`}
								text={carrera}
								iconLeft={{ icon: emoji, color: "primary" }}
								href={href}
							/>
						),
					)
				}
			</div>
		</div>
	</aside>
</section>
